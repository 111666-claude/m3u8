#EXTM3U
#EXT-X-DEFINE:NAME="CDN",VALUE="https://cdn.example.com"
#EXT-X-DEFINE:NAME="VERSION",VALUE="v5"
#EXT-X-DEFINE:NAME="REGION",VALUE="eu-west"
#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID="aud",NAME="english",LANGUAGE="en",URI="{$CDN}/audio/en/index.m3u8"
#EXT-X-MEDIA:TYPE=SUBTITLES,GROUP-ID="sub",NAME="english",LANGUAGE="en",URI="{$CDN}/subs/en/index.m3u8"
#EXT-X-STREAM-INF:BANDWIDTH=1280000,AVERAGE-BANDWIDTH=1250000,RESOLUTION=1280x720,CODECS="avc1.4d401f,mp4a.40.2",AUDIO="aud",SUBTITLES="sub"
{$CDN}/{$VERSION}/{$REGION}/720p/index.m3u8
#EXT-X-STREAM-INF:BANDWIDTH=2560000,AVERAGE-BANDWIDTH=2500000,RESOLUTION=1920x1080,CODECS="avc1.4d401f,mp4a.40.2",AUDIO="aud",SUBTITLES="sub"
{$CDN}/{$VERSION}/{$REGION}/1080p/index.m3u8
#EXT-X-I-FRAME-STREAM-INF:BANDWIDTH=1280000,URI="{$CDN}/{$VERSION}/{$REGION}/iframe/index.m3u8"
